# Leave VITE_API_URL empty to run the self-contained DEMO (sample availability, nothing is sent).
# Set it to your Spring Boot backend to go LIVE (real slots, real bookings, Google Meet link by email + WhatsApp):
#   local:      VITE_API_URL=http://localhost:8080
#   production: VITE_API_URL=https://your-backend.example.com      (no trailing slash, no /api)
# The backend must list this site's URL in CORS_ORIGINS.
VITE_API_URL=

# Optional - keep in sync with the backend (defaults shown):
# VITE_REMINDER_MINUTES=10     # backend REMINDER_MINUTES: when the Meet link is sent
# VITE_SLOT_MINUTES=30         # backend CONSULT_DURATION_MIN
# VITE_MAX_DAYS=90             # backend CONSULT_MAX_DAYS
